# Copy this file to .env and adjust the values for your environment.
#
# Out of the box this needs no API key for anything: speech recognition and
# speech synthesis both run locally, and LiveKit runs in development mode. The
# only value you must supply is CORE_API_API_KEY, which is the key of the
# ops-core-api instance holding the booking data.

# +--------------------------------------------------------------------------+
# | INFRASTRUCTURE: LIVEKIT                                                   |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.livekit.LiveKitSettings.
# devkey/secret are the pair `livekit-server --dev` issues. They are published
# in LiveKit's own documentation, so treat any deployment using them as public.
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# The URL handed to the browser inside its token. docker-compose overrides this
# per service: the worker dials ws://livekit:7880 from inside the network while
# the browser dials localhost from outside.
LIVEKIT_URL="ws://localhost:7880"

# The URL the API process uses to reach LiveKit's management API for the
# /health/ready probe. Leave unset to reuse LIVEKIT_URL. It differs whenever the
# browser and this service sit on different networks — in compose the API sets
# this to ws://livekit:7880 while the token above stays on localhost.
# LIVEKIT_INTERNAL_URL="ws://livekit:7880"

# How long a join token stays valid. Short on purpose: it only has to survive
# the moment of joining, not the call.
LIVEKIT_TOKEN_TTL_MINUTES=15

# +--------------------------------------------------------------------------+
# | APPLICATION: OPS-CORE-API (the booking data)                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.core_api.CoreApiSettings.
# Every /api/v1 endpoint of ops-core-api requires this key. Required: without
# it the worker would start and answer the first guest with a 401.
CORE_API_API_KEY="6sLo5Dt41uzEMkrBYI5Nf47blOXQlBC8kI0Xodf-CnU"

# Inside docker compose the host is reachable as host.docker.internal; running
# the worker directly on your machine, use localhost.
CORE_API_BASE_URL="http://localhost:8000"
CORE_API_TIMEOUT_SECONDS=10.0
# Total attempts per call, including the first. Small: a guest is on the line.
CORE_API_MAX_ATTEMPTS=3

# +--------------------------------------------------------------------------+
# | APPLICATION: AGENT PERSONA                                                |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.agent.AgentSettings.
# Language of the whole conversation: ru | en. It drives the speech recognition
# hint, the default voice and the persona's own instructions. STT_LANGUAGE and
# TTS_VOICE below can override their halves independently.
AGENT_LANGUAGE="ru"
AGENT_NAME="Мила"
AGENT_VENUE_NAME="Aurora"
# Larger parties are handed to a human instead of being booked by voice.
AGENT_MAX_PARTY_SIZE=12
AGENT_BOOKING_HORIZON_DAYS=30

# +--------------------------------------------------------------------------+
# | APPLICATION: DIALOGUE LLM                                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.LLMSettings.
# This is the model that talks and calls the tools — not embeddings.
# Provider profile: openai | openai_compatible | ollama
#
# The model must support tool calling. A model that cannot will hold a pleasant
# conversation and never book anything.
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY="your_api_key"
# Inside docker compose use the service name; outside use localhost.
LLM_BASE_URL="http://host.docker.internal:11434/v1"
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
# Zero: booking a table is not a creative task, and a model that improvises
# times is worse than one that repeats itself.
LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1024

# +--------------------------------------------------------------------------+
# | APPLICATION: SPEECH TO TEXT  (independent of the TTS block below)         |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.stt.STTSettings.
# Provider:
#   faster_whisper     - local Whisper on CPU, no API key, works offline (default)
#   openai_compatible  - any HTTP API implementing POST /audio/transcriptions
#
# STT and TTS are configured separately on purpose. Local recognition with a
# cloud voice, or the reverse, is a supported combination.
STT_PROVIDER="faster_whisper"

# faster_whisper: a Whisper size (tiny | base | small | medium) or a path.
# openai_compatible: the provider's transcription model name, e.g. "whisper-1".
STT_MODEL="small"

# int8 keeps CPU transcription real-time on a laptop. Use float32 for accuracy
# if you have the cores to spare.
STT_COMPUTE_TYPE="int8"

# ISO-639-1 hint. Leave unset to follow AGENT_LANGUAGE.
# STT_LANGUAGE="ru"

# For STT_PROVIDER="openai_compatible". *_BASE_URL is what selects the
# provider — nothing in the code names one. Anything implementing the OpenAI
# audio contract works, including but not limited to OpenRouter:
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
#   self-hosted http://whisper-server:8000/v1
# STT_BASE_URL="https://openrouter.ai/api/v1"
# STT_API_KEY="your_api_key"
STT_TIMEOUT_SECONDS=30.0
STT_MAX_RETRIES=2

# +--------------------------------------------------------------------------+
# | APPLICATION: TEXT TO SPEECH  (independent of the STT block above)         |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.tts.TTSSettings.
# Provider:
#   piper              - local neural voices, no API key, works offline (default)
#   openai_compatible  - any HTTP API implementing POST /audio/speech
TTS_PROVIDER="piper"

# piper voice name. Leave unset to follow AGENT_LANGUAGE:
#   ru -> ru_RU-irina-medium      en -> en_US-amy-medium
# Both are baked into the agent image; adding another means adding it to
# PIPER_VOICES in the Dockerfile.
# TTS_VOICE="ru_RU-irina-medium"

TTS_BINARY_PATH="piper"
TTS_VOICES_DIR="/opt/piper/voices"
# Medium-quality piper voices emit 22.05 kHz.
TTS_SAMPLE_RATE=22050

# For TTS_PROVIDER="openai_compatible". Same rule as STT: the base URL selects
# the provider. Set TTS_VOICE to one of that provider's voice names.
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
# TTS_BASE_URL="https://openrouter.ai/api/v1"
# TTS_API_KEY="your_api_key"
# TTS_MODEL="tts-1"
TTS_TIMEOUT_SECONDS=30.0
TTS_MAX_RETRIES=2

# A provider without an OpenAI-shaped API — Cartesia, for instance — is not
# covered by openai_compatible. It is a separate implementation of the same
# TTSClient port plus one branch in src/app/llm/tts_factory.py. See the README.

# +--------------------------------------------------------------------------+
# | APPLICATION: HTTP SERVICE                                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.app.AppSettings.
# POST /token mints room-join credentials without asking for any, so it is
# rate limited per client IP.
TOKEN_RATE_LIMIT_PER_MINUTE=20
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# +--------------------------------------------------------------------------+
# | APPLICATION: LOGGING                                                      |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings.
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Format: json (production) | text (local development)
LOG_FORMAT="json"
